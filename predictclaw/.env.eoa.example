# EOA trading template.
# Signatures, approvals, and broadcasts go through the instance-scoped platform wallet API.
# The skill never reads a raw private key.
PREDICT_STORAGE_DIR=~/.openclaw/predict
PREDICT_ENV=mainnet
PREDICT_API_BASE_URL=https://api.predict.fun
PREDICT_WALLET_MODE=eoa
PREDICT_API_KEY=YOUR_PREDICT_API_KEY

# Platform wallet signer (required)
WALLET_API_URL=https://YOUR_PLATFORM_WALLET_API
WALLET_API_TOKEN=
INSTANCE_ID=
WALLET_CHAIN_ID=56
